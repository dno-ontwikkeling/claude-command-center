{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["*.js", "renderer/**/*.js", "renderer/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "test"]
}
